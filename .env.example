# Names only — fill values locally / in Vercel. Never commit secrets.

# Required for API + seed
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=elnahass

# SMTP (required in production for real delivery; mocked/logged when unset)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=info@elnahass-sonsgroup.com
# Optional From override (defaults to EMAIL_USER)
# EMAIL_FROM=
# EMAIL_FAIL_SILENTLY=0  # set to 0 to throw on SMTP errors (default: fail silently)

NEXT_PUBLIC_SITE_URL=

# Admin auth (iron-session credentials)
# Username matches Django production admin; email login still works.
ADMIN_USERNAME=Fighter-10
ADMIN_EMAIL=admin@elnahass.local
# Set a strong password in Vercel / .env.local — do not commit real secrets
ADMIN_PASSWORD=
# Cookie encryption — min 32 characters (falls back to NEXTAUTH_SECRET)
SESSION_SECRET=dev-only-change-me-elnahass-admin-session-secret-32chars

# Optional NextAuth-style aliases (also accepted by admin login)
# NEXTAUTH_SECRET=
# NEXTAUTH_ADMIN_EMAIL=
# NEXTAUTH_ADMIN_PASSWORD=

# If set, seed + admin uploads go to Vercel Blob; otherwise public/database/*
BLOB_READ_WRITE_TOKEN=

# Playwright bases (optional; defaults in e2e/playwright.config.ts)
DJANGO_BASE=http://127.0.0.1:8000
NEXT_BASE=http://localhost:3000
